{
    "name": "b13/language-limits",
    "type": "typo3-cms-extension",
    "description": "Limit in which languages pages and content elements are shown, per record and per language, on top of the fallback chain of the site configuration.",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3",
        "extension",
        "localization",
        "language",
        "fallback"
    ],
    "authors": [
        {
            "name": "b13 GmbH",
            "homepage": "https://b13.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "typo3/cms-backend": "^14.3 || ^15.0",
        "typo3/cms-core": "^14.3 || ^15.0",
        "typo3/cms-frontend": "^14.3 || ^15.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.1 || ^13.0",
        "typo3/cms-extbase": "^14.3 || ^15.0",
        "typo3/cms-fluid": "^14.3 || ^15.0",
        "typo3/cms-install": "^14.3 || ^15.0",
        "typo3/coding-standards": "^0.9",
        "typo3/testing-framework": "^9.7"
    },
    "autoload": {
        "psr-4": {
            "B13\\LanguageLimits\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "B13\\LanguageLimits\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/Web",
            "app-dir": ".Build",
            "extension-key": "language_limits",
            "version": "0.1.0-dev",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "replace": {
        "typo3-ter/language-limits": "self.version"
    }
}
